@using Portfolio.Shared.Model
@inject IDialogService DialogService

<article class="work-card">
    <div class="thumbnail-frame @ThumbnailFrameClass">
        @if (string.IsNullOrWhiteSpace(Work.ThumbnailUrl))
        {
            <span class="thumbnail-placeholder">画像準備中</span>
        }
        else
        {
            <img src="@Work.ThumbnailUrl"
                 alt="@Work.Title"
                 loading="lazy"
                 decoding="async" />
        }
    </div>
    <div class="work-summary">
        <h4>@Work.Title</h4>
        @if (!string.IsNullOrWhiteSpace(Work.Description))
        {
            <p>@Work.Description</p>
        }
    </div>
    <button class="work-card-trigger"
            type="button"
            aria-label="@($"{Work.Title}の詳細を表示")"
            aria-haspopup="dialog"
            title="作品詳細を表示"
            @onclick="OpenDetailsAsync">
        <span class="visually-hidden">@Work.Title の詳細を見る</span>
    </button>
</article>

@code {
    [Parameter, EditorRequired]
    public WorkItem Work { get; set; } = new();

    private string ThumbnailFrameClass => Work.Category switch
    {
        WorkCategory.Banner => "thumbnail-frame--banner",
        WorkCategory.Flyer => "thumbnail-frame--flyer",
        _ => "thumbnail-frame--unknown"
    };

    private async Task OpenDetailsAsync()
    {
        var parameters = new DialogParameters<WorkDetailDialog>
        {
            { dialog => dialog.Work, Work }
        };

        var options = new DialogOptions
        {
            BackdropClick = true,
            CloseButton = true,
            CloseOnEscapeKey = true,
            FullWidth = true,
            MaxWidth = MaxWidth.ExtraLarge
        };

        await DialogService.ShowAsync<WorkDetailDialog>("作品詳細", parameters, options);
    }
}
